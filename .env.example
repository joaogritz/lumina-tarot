# Copie para .env.local e ajuste. Variáveis VITE_* ficam visíveis no JavaScript publicado:
# nunca coloque segredos aqui. O Worker não usa chaves externas: o Workers AI é um binding da Cloudflare.

# Endereço do seu Worker de interpretação (veja "Configurar seu próprio Worker" no README).
# Sem esta variável, o app usa o endpoint padrão definido em src/config.js.
VITE_ORACLE_API_URL=https://seu-worker.seu-subdominio.workers.dev
